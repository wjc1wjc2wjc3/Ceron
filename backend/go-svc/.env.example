# ===== Go 网关/编排层 =====
# Python 智能服务层地址
PYTHON_SVC_URL=http://localhost:8000
# 监听端口
GO_SVC_PORT=8080
# 异步作业 worker 数（对应 internal/queue worker pool）
WORKERS=4
# 作业完成后 CRM/核心系统同步 webhook（留空则不同步）
CRM_WEBHOOK_URL=
# 作业持久化：设置后走 Postgres（需以 -tags postgres 构建）；留空则用内存
DATABASE_URL=
# 异步队列：设置后走 NATS JetStream（需以 -tags nats 构建，支持多实例水平扩展）；留空则用进程内 worker 池
NATS_URL=

