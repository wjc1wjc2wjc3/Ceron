# ===== Python 智能服务层 =====
# LLM 提供方: mock(无密钥演示) | deepseek | qwen | glm | openai | claude
LLM_PROVIDER=mock
# 国产/国际大模型 OpenAI 兼容接口（以 DeepSeek 为例）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 数据驻留区域：hk(中国香港) / cn(中国内地)
DATA_REGION=hk
# 是否对个人/企业敏感信息脱敏
ENABLE_PII_MASKING=true

# ===== OCR（港式月结单/保单扫描件）=====
# mock | azure | tesseract
OCR_PROVIDER=mock
# Azure AI Document Intelligence（OCR_PROVIDER=azure 时必填）
AZURE_FORM_RECOGNIZER_ENDPOINT=
AZURE_FORM_RECOGNIZER_KEY=
# OCR_PROVIDER=tesseract 需本机安装 tesseract-ocr 与 chi_tra 语言包

# ===== Enrichment（富集数据源）=====
# 配置对应 API_URL 即启用该真实数据源（ICRIS 与制裁可同时启用，结果自动合并）；
# 均未配置时走 mock 基线。ENRICHMENT_PROVIDER 为单源选择（mock|icris|sanctions，遗留兼容）。
ENRICHMENT_PROVIDER=mock
# ICRIS 查冊（香港公司註冊處，需核准凭证或持牌数据服务商）
# 直连态：仅填 ICRIS_API_URL + ICRIS_API_KEY（POST 查询契约）
# 会话态（推荐）：额外填 ICRIS_AUTH_URL + ICRIS_ACCOUNT，先换 token 再以 Bearer 查询
ICRIS_API_URL=
ICRIS_API_KEY=
ICRIS_AUTH_URL=
ICRIS_ACCOUNT=
# 制裁/PEP 名单服务（UN/EU/HK MAO 或持牌服务商）
SANCTIONS_API_URL=
SANCTIONS_API_KEY=
# 土地註冊處 Land Search（按揭物业产权查冊）
LAND_SEARCH_API_URL=
LAND_SEARCH_API_KEY=
# 信貸局（TransUnion HK 等会员机构：以会员编号 + API Key 调用，建议相互 TLS）
CREDIT_BUREAU_API_URL=
CREDIT_BUREAU_API_KEY=
CREDIT_BUREAU_MEMBER_ID=
# 美国 OFAC SDN 名单筛查
OFAC_API_URL=
OFAC_API_KEY=
# 英国 HMT 综合制裁名单筛查
HMT_API_URL=
HMT_API_KEY=
# CRS / FATCA 稅務居民信息自動交換核查
CRS_API_URL=
CRS_API_KEY=

# ===== Go 网关服务（供参考；Go 侧请看 ../go-svc/.env.example）=====
# PYTHON_SVC_URL=http://localhost:8000
# GO_SVC_PORT=8080

# ===== 认证（Auth）：邮箱密码 + X / Facebook 第三方登录 =====
# 会话令牌签名密钥（生产务必更换！须与前端 AUTH_SECRET 一致，Next 端才能校验会话）
AUTH_SECRET=ceron-dev-secret-change-me
# 会话有效期（秒，默认 7 天）
AUTH_TOKEN_TTL_SECONDS=604800
# 前后端地址：OAuth 回调需外网可达的绝对 URL；X/FB 应用后台需登记同样的回调地址
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# 「使用 X 登录」：在 developer.x.com 建 App 后填入（留空则该按钮不显示）
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/v1/auth/x/callback
# 「使用 Facebook 登录」：在 developers.facebook.com 建 App 后填入
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/v1/auth/facebook/callback

# 邮箱验证码登录（免密码）：有效期与重发冷却（秒）
AUTH_CODE_TTL_SECONDS=600
AUTH_CODE_RESEND_SECONDS=60
# 密码重置令牌有效期（秒）
AUTH_RESET_TTL_SECONDS=1800

# ===== 邮件（验证码 / 重置密码）=====
# 未配置 SMTP_HOST 时不真实发信：邮件内容打印到服务日志，并把验证码/重置链接
# 回显到 API 响应（dev_code / dev_link），本地即可完整体验。生产请务必配置 SMTP，
# 并将 DEV_ECHO_SECRET=false，避免令牌出现在响应中。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_USE_SSL=false
DEV_ECHO_SECRET=true

# ===== 持久化（与 go-svc jobs 表对齐）=====
# 配置 DATABASE_URL 即切 Postgres（JSONB 持久化），否则内存兜底。
# 建议与 go-svc 共用同一实例，使 Go 看板与 Python 决策历史落在同一 jobs 表。
DATABASE_URL=
